# Copy to .env and fill in. Never commit the real .env file.

# --- Data (organizer-provided, read-only S3; all four values come from the organizer's data dictionary) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-2
DATASET_BUCKET=
DUCKDB_PATH=data/warehouse/bank.duckdb
DUCKDB_MEMORY_LIMIT=2GB
# Where the ingestion reads raw files from and writes its quality report (the container sets both)
RAW_DATA_DIR=data/raw
DQ_REPORT_PATH=data/reports/quality_report.json
# Container only: what to ingest on first boot (default: 5k-customer / 12-month sample)
INGEST_ARGS=--profile serving --sample-customers 5000 --since 2025-06-17

# --- LLM providers, tried in LLM_PROVIDERS order; one without its key is skipped ---
# The model only interprets and picks tools; it is never given customer records and never writes replies.
# Claude first: Sonnet 5 had the higher safe automated resolution and the lower cost per safe resolution on the
# held-out workload (eval/reports/SYSTEM_EVAL_LIVE.md); render.yaml runs it too.
LLM_PROVIDERS=anthropic,groq,together
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
TOGETHER_API_KEY=
TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# low | medium | high (ignored for claude-haiku-*, which rejects effort)
ANTHROPIC_EFFORT=low
# 1 = server-side refusal fallback on claude-opus-5 (recommended); 0 = off
ANTHROPIC_FALLBACKS=1
LLM_TIMEOUT_SECONDS=12
LLM_TOTAL_BUDGET_SECONDS=25
# A model on this machine or in the compose (Ollama, or any server that speaks the OpenAI chat API): no account, no key,
# no cost. It is tried only when LLM_PROVIDERS names it, e.g. LLM_PROVIDERS=local (or local,anthropic to fall back to
# a hosted one). The model must support tool calling. Outside the compose Ollama listens on 127.0.0.1:11434; in the
# compose the base URL is http://ollama:11434/v1. A local model on a CPU is slow, and its first call loads it:
# for that raise LLM_TIMEOUT_SECONDS (e.g. 90), LLM_TOTAL_BUDGET_SECONDS (e.g. 120) and TURN_BUDGET_SECONDS below it.
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_MODEL=gpt-oss:20b
# Upper bounds that keep a turn's cost and time bounded (docs/operations.md, "Capacity limits")
LLM_MAX_OUTPUT_TOKENS=4096
LLM_MAX_PROMPT_CHARS=24000
# One model spend cap per session, USD (default 0.25; 0 = off). Past it that session runs in degraded mode.
LLM_SESSION_BUDGET_USD=0.25
# Wall-clock budget of one turn: the model, its retries, the lookups and the handoff all draw on it.
TURN_BUDGET_SECONDS=30
# The handoff (evidence, write lock, ticket write and read-back) has a budget of its own, so a turn out of time can still hand over.
# A chat works for at most TURN_BUDGET_SECONDS + HANDOFF_BUDGET_SECONDS once it holds a slot.
HANDOFF_BUDGET_SECONDS=3
# Work left running after its caller gave up (evidence and read-backs / ticket writes) holds a slot until it ends; past these it is refused
BOUNDED_OPS_LIMIT=16
HANDOFF_WRITE_LIMIT=32

# --- Local model (LLM_PROVIDERS=local): an OpenAI-compatible server on this machine, e.g. Ollama. No key, no account, no cost.
# In the compose stack the defaults are http://ollama:11434/v1 (the `ollama` service, `make up-llm-local`) and gpt-oss:20b;
# for an Ollama running on the host use http://host.docker.internal:11434/v1 (`make up-llm-host`); outside Docker,
# http://127.0.0.1:11434/v1. A smaller model with tool calling, e.g. qwen3:8b or llama3.1:8b, needs less memory.
# LOCAL_LLM_BASE_URL=
# LOCAL_LLM_MODEL=

# --- Shadow / canary (off unless set). A candidate as provider:model, e.g. groq:openai/gpt-oss-120b.
# Shadow: the candidate sees the same masked messages in the background and only a log is kept (SHADOW_LOG_PATH).
# Canary: CANARY_PERCENT of sessions (stable per session) are served by the candidate; if it fails, the usual model
# answers. Compare both at /admin/experiments.
SHADOW_MODEL=
SHADOW_SAMPLE_PERCENT=100
CANARY_MODEL=
CANARY_PERCENT=0

# --- Durable state: sessions and conversations survive a restart when this names a file (SQLite, one writer).
# Empty = private in-memory state, lost on restart. Tickets, operator decisions and traces already persist as JSONL
# under data/warehouse (HUMAN_QUEUE_PATH, HUMAN_DESK_PATH, TRACE_REQUESTS_PATH).
STATE_DB_PATH=
# Where each record store lives (all default to data/warehouse/); ops/retention.py prunes exactly these files.
# Traces and audit contain customer data: keep them on the persistent disk, not in the image.
TRACE_LOG_PATH=data/warehouse/traces.jsonl
AUDIT_LOG_PATH=data/warehouse/audit_log.jsonl
HUMAN_QUEUE_PATH=data/warehouse/human_queue.jsonl
HUMAN_DESK_PATH=data/warehouse/ticket_events.jsonl
TRACE_REQUESTS_PATH=data/warehouse/trace_requests.jsonl
SHADOW_LOG_PATH=data/warehouse/shadow_log.jsonl
DRIFT_BASELINE_PATH=data/warehouse/traffic_baseline.json
# Intent classifier files (defaults are the committed model and its metadata under eval/models/): leave commented, an empty
# value here is read as a path, not as "unset"
# INTENT_MODEL_PATH=
# INTENT_META_PATH=
# Experiment tracking for `make train-eval` and `make eval` (default: local SQLite under mlruns/)
# MLFLOW_TRACKING_URI=

# --- Identity / sessions (fails closed if DEMO_IDP_SECRET is empty) ---
DEMO_IDP_SECRET=
SESSION_TTL_SECONDS=900
# Comma list of sandbox customers whose test PINs the demo UI may show (auto-picked in the container if empty)
DEMO_PUBLIC_CUSTOMERS=
# 1 = jury sandbox: guided scenarios with test PINs, "Why?" on replies, the session's tickets, fault buttons
# (api/demo.py). Keep 0 anywhere real. The web reads it too: with 0 it never asks the API for the demo.
DEMO_MODE=0

# --- Admin endpoints (disabled if empty) ---
# ADMIN_API_KEY solo LEE (cola, trazas, drift...). Actuar sobre un ticket exige la clave de un operador.
ADMIN_API_KEY=
# Bearer token a Prometheus scraper presents at GET /metrics (Authorization: Bearer ...). It opens /metrics and
# nothing else; ADMIN_API_KEY opens it too. Empty and no admin key = /metrics answers 503. Generate one like the keys below.
METRICS_TOKEN=
# Operadores: lista nombre=clave separada por comas (clave de al menos 24 caracteres, nombre [a-z0-9_.-]).
# El nombre en el registro sale de la clave. Vacía = los endpoints de acción quedan deshabilitados (503).
# Repetidos o claves cortas: el servicio no arranca. Generar una: python -c "import secrets;print(secrets.token_urlsafe(32))"
OPERATOR_KEYS=
OPERATOR_AUTH_FAILS_PER_MIN=10

# --- Limits and freshness policy ---
CHAT_RATE_PER_MIN=20
LOGIN_RATE_PER_MIN=10
# Chat messages per minute for all sessions of one customer, and from one client address (generous by default:
# behind the BFF without CLIENT_IP_HEADER every user shares the BFF's address)
CHAT_CUSTOMER_RATE_PER_MIN=40
CHAT_IP_RATE_PER_MIN=120
# Request body cap, and how many chats run at once / wait for a slot (past that: 503 + Retry-After)
MAX_REQUEST_BYTES=16384
MAX_CONCURRENT_CHATS=32
CHAT_QUEUE_MAX=64
CHAT_QUEUE_WAIT_SECONDS=5
CHAT_RETRY_AFTER_SECONDS=3
REQUEST_BODY_TIMEOUT_SECONDS=10
# Logs: text (default) or json, one object per line with the trace id
LOG_FORMAT=text
LOG_LEVEL=INFO
# Header with the client's real address, only behind an edge that sets it and no client can forge
# (Render: CF-Connecting-IP). Leave empty anywhere else.
# Behind the web BFF, which sends the end user's address in X-Client-IP: CLIENT_IP_HEADER=X-Client-IP.
# Only safe when nothing but the BFF can reach the API (private service); otherwise anyone picks their own bucket.
CLIENT_IP_HEADER=
# Daily (UTC) model spend cap in USD; past it the assistant runs in degraded mode. Empty = no cap.
LLM_DAILY_BUDGET_USD=
# Static dataset: keep 0 (answers always state the as-of date). Set 1 in production.
FRESHNESS_ENFORCE=0
FRESHNESS_SLO_HOURS=36

# --- Browser access and headers ---
# Origins allowed to call the API from a browser, comma separated (exact match, never "*"). Empty = no CORS headers:
# the frontend talks to the API from its server (the BFF), so a browser never needs it.
CORS_ALLOWED_ORIGINS=
# 1 = send Strict-Transport-Security. Only when every client reaches the service over HTTPS (Render does).
SECURITY_HSTS=0

# Serve the API's schema and interactive docs at /openapi.json, /docs and /redoc. Off by default: for development only.
EXPOSE_API_DOCS=0

# --- Retention (ops/retention.py): days a record is kept; 0 disables that rule ---
RETENTION_TRACES_DAYS=30
RETENTION_AUDIT_DAYS=30
RETENTION_SHADOW_DAYS=30
RETENTION_CONVERSATIONS_DAYS=1
# In production tickets and their events live in the bank's case system under its regulatory schedule; these are the
# sandbox stand-ins (a ticket's event log and trace requests age with the ticket).
RETENTION_TICKETS_DAYS=90
RETENTION_TICKET_EVENTS_DAYS=90
RETENTION_TRACE_REQUESTS_DAYS=90
# Hours between purges in the container (the entrypoint runs ops/retention.py --loop); 0 = do not schedule it
RETENTION_INTERVAL_HOURS=24
# Where each purge writes its result (a small JSON file that /metrics reads: when it last ran, what it dropped, what failed)
RETENTION_STATUS_PATH=data/warehouse/retention_status.json

# --- Web frontend (its server, the BFF): what the compose passes to the `web` service ---
# The origin a browser sees for the web (scheme + host + port, no path). The image runs in production mode, where the operator
# console refuses every form post unless it is exactly this origin (docs/integracion.md). Empty = http://127.0.0.1:$WEB_PORT,
# which is right for `make up`; set it when you reach the web by another name (a tunnel, a reverse proxy: https://console.example).
WEB_PUBLIC_ORIGIN=
# Header with the end user's address, only behind a proxy that sets it and no client can forge (CF-Connecting-IP on Render).
# Empty: the web uses the connection's own address, which is what a local run wants.
TRUSTED_CLIENT_IP_HEADER=
# Seconds of inactivity before an operator's session lapses (default 1800, at least 10): lower it to try the expiry.
OPERATOR_IDLE_SECONDS=
# 1 = publish the UI kit gallery at /dev/ui in the production build. 0 (default): it answers 404, as it does on a real deploy.
UI_GALLERY=0

# --- Local Docker stack (make up): host ports, published on 127.0.0.1 only ---
API_PORT=8000
WEB_PORT=3000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
OLLAMA_PORT=11434
# Grafana's admin login is admin / this password (make monitoring-up); `make env` generates one
GRAFANA_ADMIN_PASSWORD=
# make up-dataset: a host folder with the dataset's CSVs (branches.csv, customers.csv, ..., transactions/), mounted read-only,
# read by the first boot's ingestion with no S3. Give it on the command line: make up-dataset RAW_DIR=/path/to/data/raw
RAW_DIR=

# --- Stateless alert check (`python -m ops.alerts`, run from cron or CI; also `docker compose exec api python -m ops.alerts`)
# The service to check (e.g. http://127.0.0.1:8000) and, optionally, a webhook that receives the ALERT lines. Needs ADMIN_API_KEY.
ALERT_BASE_URL=
ALERT_WEBHOOK_URL=
