# Copy to .env and fill in. Never commit the real .env file.

# S3 access for the LATAM Bank dataset (organizer-provided, read-only).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-2
DATASET_BUCKET=***REMOVED***

# LLM providers for the conversational core.
GROQ_API_KEY=
TOGETHER_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# Local DuckDB warehouse file (created by data/pipeline.py).
DUCKDB_PATH=data/warehouse/bank.duckdb

# Mock session/auth service.
SESSION_TTL_SECONDS=900
