# Server-only address. Never prefix backend secrets with VITE_.
AGENT_API_URL=http://127.0.0.1:8000

# Header carrying the end user's IP, set by a proxy no client can bypass (CF-Connecting-IP on Render).
# Leave empty elsewhere: the socket address is used and a client-sent header would be forgeable.
TRUSTED_CLIENT_IP_HEADER=

# The secret this server and the API share (the same value as the API's BFF_CLIENT_IP_SECRET, 16 characters or more). It is sent
# to the API with the end user's address, which the API believes only on a call that carries it. Empty: the address is sent
# without it and the API ignores it. Never prefix it with VITE_.
BFF_CLIENT_IP_SECRET=

# The origin browsers see for this app (scheme + host + port, no path), for example https://console.bank.example.
# It may be a comma-separated list of exact origins when the app answers on several (a local run: http://127.0.0.1:3000,http://localhost:3000).
# Every entry must be a pure origin with an ASCII host (an IDN in punycode): no wildcard, user@, path, query or fragment; one bad entry, or a list mixing http and https,
# invalidates the whole value. In production use one explicit https origin.
# The operator forms only accept posts whose Origin/Referer is exactly this, so it is REQUIRED in production: without it
# every form post is refused and the server logs why. In development, when empty, it is the origin of the request URL.
# It is never derived from X-Forwarded-* headers.
# It also decides the session cookies (not NODE_ENV): an https origin gives Secure cookies with the __Host- prefix; an http origin
# (a local run) gives neither, because browsers such as Safari do not store a Secure cookie from plain http. Empty in production
# keeps Secure. httpOnly and SameSite stay on either way.
WEB_PUBLIC_ORIGIN=
