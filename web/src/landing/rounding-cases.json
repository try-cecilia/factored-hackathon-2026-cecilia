{
  "contract": "The shortest decimal form of the number that reads back as the same float (Python's repr, JavaScript's String), times a power of ten, rounded half up; any size, and no negative zero (what rounds to zero is written unsigned). eval/check_readme.py (_fixed) and web/src/landing/rounding.ts (roundHalfUp) both read this file in their tests.",
  "cases": [
    {
      "value": 2.25,
      "digits": 1,
      "expected": "2.3"
    },
    {
      "value": 2.35,
      "digits": 1,
      "expected": "2.4"
    },
    {
      "value": 2.55,
      "digits": 1,
      "expected": "2.6"
    },
    {
      "value": 2.449999999999,
      "digits": 1,
      "expected": "2.4"
    },
    {
      "value": 0.05,
      "digits": 1,
      "expected": "0.1"
    },
    {
      "value": 0.15,
      "digits": 1,
      "expected": "0.2"
    },
    {
      "value": 1.005,
      "digits": 2,
      "expected": "1.01"
    },
    {
      "value": 5e-05,
      "digits": 4,
      "expected": "0.0001"
    },
    {
      "value": 5.0,
      "digits": 1,
      "expected": "5.0"
    },
    {
      "value": 4425008,
      "digits": 0,
      "expected": "4425008"
    },
    {
      "value": 1165.5,
      "digits": 1,
      "shift": -3,
      "expected": "1.2"
    },
    {
      "value": 1250,
      "digits": 1,
      "shift": -3,
      "expected": "1.3"
    },
    {
      "value": 0.9762,
      "digits": 1,
      "shift": 2,
      "expected": "97.6"
    },
    {
      "value": 0.0217,
      "digits": 1,
      "shift": 2,
      "expected": "2.2"
    },
    {
      "value": 0.0055,
      "digits": 2,
      "shift": 2,
      "expected": "0.55"
    },
    {
      "value": 0.003376,
      "digits": 4,
      "expected": "0.0034"
    },
    {
      "value": 1e+27,
      "digits": 1,
      "expected": "1000000000000000000000000000.0"
    },
    {
      "value": 1.2345678901234568e+29,
      "digits": 0,
      "expected": "123456789012345680000000000000"
    },
    {
      "value": -0.0,
      "digits": 1,
      "expected": "0.0"
    },
    {
      "value": -0.01,
      "digits": 1,
      "expected": "0.0"
    },
    {
      "value": -0.04,
      "digits": 0,
      "expected": "0"
    },
    {
      "value": -2.25,
      "digits": 1,
      "expected": "-2.3"
    }
  ]
}
