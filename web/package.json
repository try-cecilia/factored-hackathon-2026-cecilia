{
  "name": "@cecilai/web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --strictPort",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\" && vitest run",
    "test:dom": "vitest run",
    "test:http": "vite build && node --test \"tests/http/*.test.ts\"",
    "test:all": "pnpm test && pnpm test:http"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/dm-mono": "5.3.0",
    "@tanstack/react-router": "1.170.40",
    "@tanstack/react-start": "1.168.59",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "seroval": "1.6.7"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "jsdom": "29.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24 <25"
  }
}
